# Copy this file to .env and fill in the values from your keys.txt.
# .env is gitignored, so your keys stay on your machine.

# The "API key" shown when you created a TOTP key on
# https://groww.in/trade-api/api-keys (a long JWT string).
GROWW_API_KEY=

# The TOTP secret (base32 string, the one you'd scan as a QR code).
GROWW_TOTP_SECRET=

# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me

# Postgres connection (Codespaces sets this for you).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/trading
