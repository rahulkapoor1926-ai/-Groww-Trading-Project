{
  "name": "Groww Trading Project",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install -r requirements-dev.txt",
  "postAttachCommand": "python run.py",
  "containerEnv": {
    "FLASK_HOST": "0.0.0.0",
    "FLASK_PORT": "5000"
  },
  "forwardPorts": [5000],
  "portsAttributes": {
    "5000": { "label": "Groww Dashboard", "onAutoForward": "openBrowser" }
  },
  "secrets": {
    "GROWW_API_KEY": { "description": "API key of your Groww TOTP key" },
    "GROWW_TOTP_SECRET": { "description": "TOTP secret of your Groww key" },
    "FLASK_SECRET_KEY": { "description": "Any long random string" }
  },
  "customizations": {
    "vscode": { "extensions": ["ms-python.python", "charliermarsh.ruff"] }
  }
}
